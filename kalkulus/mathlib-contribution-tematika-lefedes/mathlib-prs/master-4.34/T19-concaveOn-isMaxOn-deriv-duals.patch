+  have h := hf.neg.isMinOn_of_rightDeriv_eq_zero hx (by simpa [derivWithin.neg] using hf_rd)
+  simpa using h.neg
+
+lemma isMaxOn_of_leftDeriv_eq_zero (hf : ConcaveOn ℝ S f) (hx : x ∈ interior S)
+    (hf_ld : derivWithin f (Iio x) x = 0) :
+    IsMaxOn f S x := by
+  have h := hf.neg.isMinOn_of_leftDeriv_eq_zero hx (by simpa [derivWithin.neg] using hf_ld)
+  simpa using h.neg
