+lemma isMaxOn_of_leftDeriv_nonneg_of_rightDeriv_nonpos (hf : ConcaveOn ℝ S f) (hx : x ∈ interior S)
+    (hf_ld : 0 ≤ derivWithin f (Iio x) x) (hf_rd : derivWithin f (Ioi x) x ≤ 0) :
+    IsMaxOn f S x := by
+  have h := hf.neg.isMinOn_of_leftDeriv_nonpos_of_rightDeriv_nonneg hx
+    (by simpa [derivWithin.neg] using hf_ld) (by simpa [derivWithin.neg] using hf_rd)
